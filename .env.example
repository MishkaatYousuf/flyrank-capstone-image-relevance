# Copy this file to .env and fill in your own values.
# .env is git-ignored — never commit real keys.

# --- Vision / LLM provider (free tier, no credit card) ---
# Get a free key at https://aistudio.google.com/apikey (Google account only)
GEMINI_API_KEY=

# Free-tier model. gemini-2.5-flash is free with rate limits (~10 RPM / 250 RPD
# as of 2026 — check https://aistudio.google.com for your current live limits).
GEMINI_MODEL=gemini-2.5-flash

# --- Local/offline fallback (fully free, no key, no internet needed) ---
# If you'd rather run 100% locally via Ollama instead of Gemini, set this to
# "ollama" and install a vision model, e.g.: `ollama pull llava`
VISION_PROVIDER=gemini
OLLAMA_MODEL=llava
OLLAMA_HOST=http://localhost:11434

# --- Image corpus source (free, no card) ---
# Get a free key at https://www.pexels.com/api/
PEXELS_API_KEY=

# --- Database (SQLite = $0, zero config, no Docker required at this scale) ---
DATABASE_URL=sqlite:///./capstone.db

# --- Pipeline tuning ---
LOW_CONFIDENCE_THRESHOLD=0.6
MAX_VISION_RETRIES=3
VISION_RETRY_BACKOFF_SECONDS=2
